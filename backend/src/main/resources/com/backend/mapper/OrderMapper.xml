<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.backend.mapper.OrderMapper">

    <!-- 计数SQL -->
    <select id="countAdminOrders" resultType="int">
        SELECT COUNT(*) FROM `order`
        <where>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="search != null and search != ''">
                AND (order_number LIKE CONCAT('%', #{search}, '%')
                OR remark LIKE CONCAT('%', #{search}, '%'))
            </if>
            <if test="startTime != null and startTime != ''">
                AND created_at >= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND created_at &lt;= #{endTime}
            </if>
        </where>
    </select>

    <!-- 管理员获取订单列表（带筛选和分页） -->
    <select id="getAdminOrders" resultMap="orderResultMap">
        <![CDATA[
        SELECT * FROM `order`
        ]]>
        <where>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        <if test="sortField != null">
            ORDER BY ${sortField} ${sortOrder}
        </if>
        LIMIT #{offset}, #{pageSize}
    </select>

    <!-- 用户获取订单列表（带筛选和排序） -->
    <select id="getOrdersByUserIdWithFilter" resultMap="orderResultMap">
        SELECT * FROM `order` WHERE cus_id = #{userId}
        <if test="status != null">
            AND status = #{status}
        </if>
        <if test="sortField != null">
            ORDER BY ${sortField} ${sortOrder}
        </if>
    </select>

    <!-- 订单结果映射 -->
    <resultMap id="orderResultMap" type="com.backend.pojo.Order">
        <id property="orderId" column="order_id"/>
        <result property="orderNumber" column="order_number"/>
        <result property="cusId" column="cus_id"/>
        <result property="addressId" column="address_id"/>
        <result property="status" column="status"/>
        <result property="totalAmount" column="total_amount"/>
        <result property="paymentMethod" column="payment_method"/>
        <result property="paymentTime" column="payment_time"/>
        <result property="deliveryTime" column="delivery_time"/>
        <result property="shippingTime" column="shipping_time"/>
        <result property="completedTime" column="completed_time"/>
        <result property="remark" column="remark"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>

        <!-- 关联收货地址 -->
        <association property="shippingAddress" column="address_id"
                     select="com.backend.mapper.ShippingAddressMapper.getAddressById"/>

        <!-- 关联订单商品项 -->
        <collection property="items" column="order_id"
                    select="getOrderItems"/>
    </resultMap>
</mapper>